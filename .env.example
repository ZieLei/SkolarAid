# Copy to .env and fill in. Never commit .env.

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=iskolaraid
MYSQL_USER=skolaraid
MYSQL_PASSWORD=change-me-db

# --- API ---
# MySql (default) or MariaDb; set the version too (e.g. 11.4.0) when running ./run.sh dev against MariaDB
DB_SERVER_TYPE=MySql
DB_SERVER_VERSION=8.0.36
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_KEY=
# First admin account (created only if no ADMIN exists yet)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# true = insert 3 sample scholarship types when the table is empty
SEED_SAMPLE_DATA=false
# true = fill an empty dev database with 2 years of dummy scholars, payments, notifications and logs (once; password Scholar#123)
SEED_HISTORICAL_DATA=false
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=https://localhost:4200

# --- Email (optional) ---
# Empty SMTP_HOST: ./run.sh demo/dev send mail to a local Mailpit inbox at http://localhost:8025
# (install it once with ./run.sh mailpit; MAIL_CATCHER=0 turns this off). Docker: empty = email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_LOGIN_URL=https://localhost:4200/login

